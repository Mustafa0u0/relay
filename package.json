{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A sync server for operation-based CRDTs — rooms, catch-up on join, and reconnection, without ever understanding what it is relaying.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test tests/*.test.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
